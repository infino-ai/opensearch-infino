 {
  "name": "range-auto-date-histo-with-metrics",
  "body": {
   "size": 0,
   "aggs": {
    "tmax": {
     "range": {
      "field": "metrics.size",
      "ranges": [
       {
        "to": 100
       },
       {
        "from": 100,
        "to": 1000
       },
       {
        "from": 1000,
        "to": 2000
       },
       {
        "from": 2000
       }
      ]
     },
     "aggs": {
      "date": {
       "auto_date_histogram": {
        "field": "@timestamp",
        "buckets": 10
