# Copy to .env before starting (cp env.example .env); .env is git-ignored.

# OpenSearch release; the plugin is built for exactly this one.
# The plugin supports 2.19.6, 3.0.0, 3.3.2, 3.6.0 and 3.9.0.
# Tested with this Docker setup, with local storage and Dashboards: all five.
# Cloud storage has not been tested yet on any release.
# Match the Gradle image to the release:
#   2.19.x -> gradle:8.12.1-jdk21   3.0.x -> gradle:8.14-jdk21   3.3+ -> gradle:9-jdk21
OPENSEARCH_VERSION=3.9.0
GRADLE_IMAGE=gradle:9-jdk21

# Initial password for the 'admin' user (needs upper, lower, digit and symbol).
OPENSEARCH_ADMIN_PASSWORD=

# Where the tables live: local (infino-data volume, the default), cloud (Infino Cloud account) or memory.
# To change it on an existing setup, run `docker compose down -v` first: the node's
# data volume belongs to the storage it was first started with.
INFINO_STORAGE=local

# cloud
INFINO_API_KEY=
# Also where a trial account is created from in local/memory mode.
INFINO_PLATFORM_URL=https://api.platform.infino.ws
# The account's database; defaults to CLUSTER_NAME.
INFINO_DATABASE=
CLUSTER_NAME=opensearch-infino

# local: leave empty for the infino-data volume, or s3://bucket/prefix (EC2 instance role, bucket in
# us-east-1; on EC2 set the instance's metadata hop limit to 2), or gs://bucket/prefix (GCE service account)
INFINO_URI=

# Optional
#INFINO_LOG_LEVEL=DEBUG
#OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
#OPENSEARCH_PORT=9200
# How long a stopping node gets to commit pending writes to Infino before Docker kills it.
#OPENSEARCH_STOP_GRACE_PERIOD=2m
#REMOVE_NEURAL_SEARCH=true
#RUST_TOOLCHAIN=1.95.0
# Not read yet: S3 uses the EC2 instance role only.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=

# The OpenSearch Dashboard is in a Compose profile, so a plain `docker compose up` skips it.
# Uncomment this line to start it with every `up` (it waits for OpenSearch to be healthy).
#COMPOSE_PROFILES=dashboards

# The OpenSearch Dashboard version defaults to OPENSEARCH_VERSION, but it can be manually
# set with DASHBOARDS_VERSION below. Note: there is no Dashboards 3.3.2 image,
# so use 3.3.0 with 3.3.2.
#DASHBOARDS_VERSION=

# OpenSearch Dashboard listens on port 5601, accessible via http://this-machine:5601. The
# port can be changed here.
#DASHBOARDS_PORT=5601

# HTTPS certificate for OpenSearch (9200) and the OpenSearch Dashboard (5601). Without these,
# OpenSearch uses its self-signed demo certificate and the Dashboard serves plain HTTP.
# PEM files: the certificate with its chain (e.g. Let's Encrypt fullchain.pem) and its
# private key. Both containers run as uid 1000, so the key must be readable by that user.
# Recreate the containers (docker compose up -d) to pick up a renewed certificate.
#TLS_CERT=/etc/ssl/opensearch/fullchain.pem
#TLS_KEY=/etc/ssl/opensearch/privkey.pem
